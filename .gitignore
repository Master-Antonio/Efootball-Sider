# ==============================================================================
# eFootball Sider by Toriga - .gitignore
# ==============================================================================

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Rust & C++ Build Output ---
target/
**/target/
build/
*.obj
*.exp
*.lib
*.ilk
*.pdb

# --- Testing & Quality Tools ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- Operating System Artifacts ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride
._*

# --- IDEs & Editors ---
.idea/
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Game Executables, Dumps & Large Temp Files ---
*.exe
*.dmp
*.log
*.tmp
*.bak
*.raw_backup
*.extracted/
temp/
scratch/
.system_generated/

# --- Live Assets & Mods (Preserve folder structure) ---
live_assets/*/*
!live_assets/*/.gitkeep
content/*/*
!content/*/.gitkeep
!content/*/README.txt
